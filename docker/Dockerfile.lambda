FROM public.ecr.aws/lambda/python:3.12 AS base

RUN dnf update -y && \
    dnf install -y gcc python3-devel git && \
    dnf upgrade -y ca-certificates && \
    dnf clean all

# Amazon Linux has no patched ca-certificates yet: blocklist the roots affected by the eMudhra intermediate CA compromise
RUN python3 -c "import re,ssl,hashlib,pathlib; b=pathlib.Path('/etc/pki/tls/certs/ca-bundle.crt').read_text(); d=pathlib.Path('/etc/pki/ca-trust/source/blocklist'); d.mkdir(parents=True,exist_ok=True); bad={'86A1ECBA089C4A8D3BBE2734C612BA341D813E043CF9E8A862CD5C57A36BBE6B','D7A7A0FB5D7E2731D771E9484EBCDEF71D5F0C3E0A2948782BC83EE0EA699EF4','7DD78D5F4F13459A83DFF9ABBBA62EDBAF6F2D102BF257FD712F4D9F2746ED8D','F2EDAAFF3D9B701FB4D14C9F285F8C0BAD90FC3BCC1FA07D47F4718EDABA34A5'}; [(d/('distrust-'+h[:8]+'.pem')).write_text(c+'\n') for c in re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----',b,re.S) for h in [hashlib.sha256(ssl.PEM_cert_to_DER_cert(c)).hexdigest().upper()] if h in bad]" && \
    update-ca-trust extract

ADD pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir . && rm pyproject.toml
RUN pip install --no-cache-dir mangum==0.17.0
COPY pr_agent/ ${LAMBDA_TASK_ROOT}/pr_agent/

FROM base AS github_lambda
CMD ["pr_agent.servers.github_lambda_webhook.lambda_handler"]

FROM base AS gitlab_lambda
CMD ["pr_agent.servers.gitlab_lambda_webhook.lambda_handler"]

FROM github_lambda
